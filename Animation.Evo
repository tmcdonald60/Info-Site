<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Evolution of Animation</title>
  <style>
    body {
      margin: 0;
      font-family: 'Arial', sans-serif;
      background: #0a2a5e;
      color: white;
    }
    .header {
      background: #0a2a5e;
      padding: 40px 20px 20px;
      text-align: center;
      position: relative;
    }
    .pizza-character {
      position: absolute;
      top: 20px;
      left: 30px;
      width: 220px;
    }
    .title {
      font-size: 2.8rem;
      margin: 0;
      color: white;
    }
    .date {
      background: #ff6b9d;
      color: white;
      padding: 8px 20px;
      border-radius: 30px;
      display: inline-block;
      margin-top: 10px;
      font-weight: bold;
    }
    .section {
      padding: 40px 5%;
    }
    .evolution-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
      margin-top: 30px;
    }
    .card {
      border-radius: 12px;
      padding: 15px;
      text-align: center;
      color: white;
    }
    .early { background: #f9c74f; color: #0a2a5e; }
    .classic { background: #ff9ec0; }
    .modern { background: #c47dff; }
    .card img {
      width: 100%;
      border-radius: 10px;
      margin-bottom: 15px;
    }
    .techniques {
      background: #ff6b9d;
      color: #0a2a5e;
    }
    .techniques-content {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      align-items: center;
    }
    .techniques-list {
      flex: 1;
      min-width: 280px;
    }
    .techniques-list ul {
      list-style: none;
      padding: 0;
    }
    .techniques-list li {
      margin: 12px 0;
      font-size: 1.1rem;
    }
    .timeline {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 20px;
    }
    .timeline-item {
      background: #ff9ec0;
      color: #0a2a5e;
      padding: 15px 20px;
      border-radius: 12px;
      text-align: center;
      flex: 1;
      min-width: 160px;
    }
    .modern-techniques {
      background: #0a2a5e;
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      align-items: center;
    }
    .modern-techniques img {
      width: 100%;
      max-width: 320px;
      border-radius: 12px;
    }
    .next-steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 15px;
    }
    .step-card {
      background: #ff9ec0;
      color: #0a2a5e;
      padding: 20px;
      border-radius: 12px;
      text-align: center;
    }
    .step-card.yellow {
      background: #ffd166;
    }
    h2 {
      text-align: center;
      color: white;
      margin-bottom: 20px;
    }
    h3 {
      margin: 10px 0;
      font-size: 1.4rem;
    }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="header">
    <img src="https://i.imgur.com/So4WA.png" alt="Pizza Character" class="pizza-character" style="width:220px;">
    <h1 class="title">The Evolution of Animation</h1>
    <div class="date">March 31, 2026</div>
  </div>

  <div class="section">
    <h2>THE EVOLUTION OF ANIMATION</h2>
    <div class="evolution-grid">
      <!-- Early Animation -->
      <div class="card early">
        <img src="https://via.placeholder.com/400x250/8B4513/FFFFFF?text=Phenakistoscope" alt="Early Animation">
        <h3>Early Animation</h3>
        <p>The phenakistoscope was one of the earliest devices for creating animation.</p>
      </div>
      <!-- Classic Animation -->
      <div class="card classic">
        <img src="https://via.placeholder.com/400x250/000000/FFFFFF?text=Mickey+Mouse" alt="Classic Animation">
        <h3>Classic Animation</h3>
        <p>Hand-drawn animation brought characters to life on the big screen.</p>
      </div>
      <!-- Modern Animation -->
      <div class="card modern">
        <img src="https://via.placeholder.com/400x250/1a1a2e/FFFFFF?text=Cyberpunk+City" alt="Modern Animation">
        <h3>Modern Animation</h3>
        <p>CGI revolutionized storytelling with its lifelike visuals and immersive worlds.</p>
      </div>
    </div>
  </div>

  <!-- Techniques Section -->
  <div class="section techniques">
    <h2>TECHNIQUES</h2>
    <div class="techniques-content">
      <div class="techniques-list">
        <ul>
          <li>• Stop Motion</li>
          <li>• Rotoscoping</li>
          <li>• 2D Hand-drawn Animation</li>
        </ul>
      </div>
      <img src="https://via.placeholder.com/600x350/ffffff/333333?text=Hand+Drawing+Animation" alt="Artist drawing" style="max-width:500px;">
    </div>
  </div>

  <!-- Timeline -->
  <div class="section">
    <h2>TIMELINE</h2>
    <div class="timeline">
      <div class="timeline-item"><strong>BEGINNINGS</strong><br>Early animation</div>
      <div class="timeline-item"><strong>DEVELOPMENT</strong><br>Silent films</div>
      <div class="timeline-item"><strong>INNOVATION</strong><br>Cartoon shorts</div>
      <div class="timeline-item"><strong>EXPANSION</strong><br>Feature films</div>
      <div class="timeline-item"><strong>MODERNIZATION</strong><br>Digital animation</div>
    </div>
  </div>

  <!-- Modern Animation Techniques -->
  <div class="section">
    <h2>MODERN ANIMATION TECHNIQUES</h2>
    <div class="modern-techniques">
      <img src="https://via.placeholder.com/350x300/2c3e50/FFFFFF?text=Gollum" alt="Gollum">
      <img src="https://via.placeholder.com/350x300/3498db/FFFFFF?text=Motion+Capture" alt="Motion Capture Suit">
      <div style="flex:1; min-width:300px;">
        <ul>
          <li>• 3D Animation techniques</li>
          <li>• Motion Capture technology</li>
          <li>• Virtual Reality experiences</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Next Steps -->
  <div class="section" style="background:#0a2a5e;">
    <h2>NEXT STEPS</h2>
    <div class="next-steps">
      <div class="step-card">
        <strong>Dive into Classics</strong>
        <ul style="text-align:left; margin:10px 0 0; padding-left:20px;">
          <li>• Watch classic films</li>
          <li>• Discover animation origins</li>
        </ul>
      </div>
      <div class="step-card yellow">
        <strong>Master Animation Skills</strong>
        <ul style="text-align:left; margin:10px 0 0; padding-left:20px;">
          <li>• Study animation styles</li>
          <li>• Analyze famous works</li>
        </ul>
      </div>
      <div class="step-card">
        <strong>Engage with Creators</strong>
        <ul style="text-align:left; margin:10px 0 0; padding-left:20px;">
          <li>• Share your art</li>
          <li>• Connect with experts</li>
        </ul>
      </div>
      <div class="step-card">
        <strong>Explore Animation History</strong>
        <ul style="text-align:left; margin:10px 0 0; padding-left:20px;">
          <li>• Watch classic films</li>
          <li>• Discover animation origins</li>
        </ul>
      </div>
    </div>
  </div>

</body>
</html>
